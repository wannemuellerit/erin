        "i18n:check": "node scripts/check-i18n.mjs",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:e2e": "playwright test",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
